# ops DB. 로컬은 파일, 운영은 Turso의 libsql:// URL
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# 감시 대상 JSON 배열. 실제 사이트 정보는 repo가 아니라 환경변수에 둔다.
OPS_TARGETS=[{"id":"example","name":"Example","vercel":{"projectId":"prj_example","productionBranch":"main"},"sentry":{"project":"example-prod","environment":"production"},"slackChannel":"#ops-example","areas":[{"name":"인증","severity":"P1","match":["auth"]}]}]

# Slack 앱. 봇 토큰(chat:write)과 버튼 요청 서명 비밀
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# 버튼을 누를 수 있고 P1에 멘션할 사람의 Slack user ID(U로 시작)
SLACK_OWNER_USER_ID=

# 수집 출처. Sentry는 Sentry를 쓰는 target이 있을 때만 필요(Internal Integration, Issue & Event Read)
SENTRY_ORG=
SENTRY_TOKEN=
# Vercel 팀 ID(team_로 시작)와 팀 범위 토큰
VERCEL_TEAM_ID=
VERCEL_TOKEN=

# /api/cron/collect 인증. Vercel Cron이 Authorization: Bearer 로 붙여 보낸다(16자 이상)
CRON_SECRET=
# 외부 heartbeat 핑 주소(https). 운영에만 둔다
HEARTBEAT_URL=

# Vercel 팀 Settings → Webhooks에서 만든 webhook의 비밀(만들 때 한 번만 보임). /api/webhooks/vercel 서명 확인용
VERCEL_WEBHOOK_SECRET=
